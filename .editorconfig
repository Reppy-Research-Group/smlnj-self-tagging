root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space

[*.{sml,sig,fun,lex,grm}]
indent_size = 2
max_line_length = 80
tab_width = 8

[*.py]
indent_size = 4
max_line_length = 80

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
tab_width = 4

